<Window x:Class="Whisper.Preview.VaesenLibrary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whisper · Biblioteca de Vaesen" Width="1150" Height="750" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Backdrop}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="30,26,30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False" Margin="0,0,0,19">
            <Border DockPanel.Dock="Right" Style="{StaticResource Panel}" CornerRadius="14" Padding="13,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Acervo local · 3 livros" Foreground="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Left" Style="{StaticResource Logo}" Margin="0,3,16,0" VerticalAlignment="Top">
                <TextBlock Text="W" FontFamily="Georgia" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource AccentInk}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="0,-3,0,0" />
            </Border>
            <StackPanel>
                <TextBlock Text="WHISPER  /  ACERVO DE REGRAS" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Biblioteca de Vaesen" FontFamily="Georgia" FontSize="34" Margin="0,3,0,3" />
                <TextBlock Text="Consulte regras, fichas e tabelas de jogo por tópico." Foreground="{StaticResource Muted}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="15,10" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,4,13,4">
                    <Grid Width="250">
                        <TextBox x:Name="Query" KeyDown="SubmitQuery" AutomationProperties.Name="Buscar regras" Padding="32,6,10,6" />
                        <Path Data="M 0 4.5 A 4.5 4.5 0 1 1 9 4.5 A 4.5 4.5 0 1 1 0 4.5 M 8 8 L 11.5 11.5" Stroke="{StaticResource Muted}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left"
                              VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Buscar regra, criatura ou ritual" Foreground="{StaticResource Muted}" FontSize="12"
                                   Margin="32,0,7,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=Query}" Value="" />
                                                <Condition Binding="{Binding IsKeyboardFocused, ElementName=Query}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Content="Buscar" Click="RunSearch" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" />
                </StackPanel>
                <ComboBox x:Name="BookFilter" Width="195" Margin="0,4,8,4" SelectionChanged="RefreshFilter"
                          AutomationProperties.Name="Livro" ToolTip="Filtrar por livro" />
                <ComboBox x:Name="CategoryFilter" Width="156" Margin="0,4,12,4" SelectionChanged="RefreshFilter"
                          AutomationProperties.Name="Categoria" ToolTip="Escolher categoria ou navegar pelas páginas" />
                <CheckBox x:Name="OptionalOnly" Content="Opcionais e variantes" Foreground="{StaticResource Text}"
                          VerticalAlignment="Center" Margin="0,4,0,4" Checked="RefreshFilter" Unchecked="RefreshFilter" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36*" MinWidth="246" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="64*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1" Padding="17,13">
                        <StackPanel>
                            <TextBlock Text="REFERÊNCIAS" Style="{StaticResource Eyebrow}" />
                            <TextBlock x:Name="ResultCount" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="Results" SelectionChanged="SelectPage" Background="Transparent" Foreground="{StaticResource Text}"
                             BorderThickness="0" Padding="6,5" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Referências encontradas">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Margin="2,2" CornerRadius="8" BorderThickness="1"
                                                    BorderBrush="Transparent" Background="Transparent">
                                                <Grid>
                                                    <Border x:Name="SelectionMarker" Width="3" CornerRadius="1"
                                                            HorizontalAlignment="Left" Margin="2,8,0,8"
                                                            Background="Transparent" />
                                                    <ContentPresenter Margin="13,9,10,9" HorizontalAlignment="Stretch" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Control}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource ControlHover}" />
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Outline}" />
                                                    <Setter TargetName="SelectionMarker" Property="Background" Value="{StaticResource Accent}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Gold}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ShortSource}" Foreground="{StaticResource Muted}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Source.Book.Title}" />
                                        <TextBlock Grid.Column="1" Text="{Binding PageLabel}" Foreground="{StaticResource Accent}"
                                                   FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="{Binding Blurb}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" MaxHeight="34" ToolTip="{Binding Blurb}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="0,5,0,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Blurb}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource Gold}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="0,4,0,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Paper}" CornerRadius="14" TextElement.Foreground="{StaticResource PaperInk}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource PaperLine}" BorderThickness="0,0,0,1" Padding="26,22,26,16">
                        <StackPanel>
                            <TextBlock Text="FONTE SELECIONADA" Style="{StaticResource Eyebrow}" Foreground="{StaticResource PaperMuted}" />
                            <TextBlock x:Name="ReaderTitle" FontFamily="Georgia" FontSize="26" TextWrapping="Wrap" Margin="0,5,0,7" />
                            <TextBlock x:Name="ReaderSource" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReaderLocation" Foreground="{StaticResource PaperMuted}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock x:Name="ReaderNote" Foreground="{StaticResource PaperMuted}" FontSize="12"
                                       FontStyle="Italic" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="Collapsed" />
                            <Border x:Name="QuickPanel" Background="#EBE3D1" BorderBrush="{StaticResource PaperLine}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,11,14,5" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="LEITURA RÁPIDA" FontWeight="Bold" FontSize="10" Foreground="{StaticResource PaperMuted}" />
                                    <TextBlock x:Name="QuickWhen" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    <ItemsControl x:Name="QuickFacts" Focusable="False" Margin="0,9,0,0"
                                                  AutomationProperties.Name="Números e regras-chave do tópico">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource PaperLine}" BorderThickness="1"
                                                        CornerRadius="8" Padding="10,6,12,7" Margin="0,0,8,8" MaxWidth="340">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding LabelUpper}" FontSize="9.5" FontWeight="Bold"
                                                                   Foreground="{StaticResource PaperMuted}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ReaderSummaryPanel" Background="{StaticResource PaperLine}" CornerRadius="9"
                                    Padding="13,10" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="EM RESUMO" FontWeight="Bold" FontSize="10" Foreground="{StaticResource PaperMuted}" />
                                    <TextBlock x:Name="ReaderSummary" TextWrapping="Wrap" FontSize="13" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <FlowDocumentScrollViewer x:Name="PageText" Grid.Row="1" IsToolBarVisible="False" IsSelectionEnabled="True"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Background="{StaticResource Paper}" Foreground="{StaticResource PaperInk}"
                                              AutomationProperties.Name="Conteúdo técnico do tópico selecionado" />
                    <Border Grid.Row="2" BorderBrush="{StaticResource PaperLine}" BorderThickness="0,1,0,0" Padding="16,9">
                        <DockPanel>
                            <Button x:Name="OpenPdfButton" DockPanel.Dock="Right" Content="Abrir PDF original"
                                    Click="OpenPdf" IsEnabled="False" Background="{StaticResource PaperInk}"
                                    BorderBrush="{StaticResource PaperInk}" />
                            <Button x:Name="ToggleViewButton" DockPanel.Dock="Right" Visibility="Collapsed" MinWidth="150"
                                    Click="ToggleView" Margin="0,0,8,0" Background="{StaticResource PaperInk}"
                                    BorderBrush="{StaticResource PaperInk}" />
                            <Button x:Name="ToggleLanguageButton" DockPanel.Dock="Right" Visibility="Collapsed" MinWidth="166"
                                    Click="ToggleLanguage" Margin="0,0,8,0" Background="{StaticResource PaperInk}"
                                    BorderBrush="{StaticResource PaperInk}" />
                            <TextBlock x:Name="ReadingLanguage" VerticalAlignment="Center" Foreground="{StaticResource PaperMuted}"
                                       TextWrapping="Wrap" Margin="4,0,8,0" FontSize="12" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
