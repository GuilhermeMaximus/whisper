<Window x:Class="Whisper.Preview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whisper · Prévia local" Width="880" Height="790" MinWidth="625" MinHeight="475"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Backdrop}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,28,34,26">
            <!-- Cabeçalho -->
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Biblioteca de Vaesen" Click="OpenLibrary"
                        VerticalAlignment="Top" Margin="12,6,0,0" />
                <Border DockPanel.Dock="Left" Style="{StaticResource Logo}" Margin="0,3,16,0" VerticalAlignment="Top">
                    <TextBlock Text="W" FontFamily="Georgia" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource AccentInk}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="0,-3,0,0" />
                </Border>
                <StackPanel>
                    <TextBlock Text="WHISPER  /  ESCUTA LOCAL" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Copiloto de mesa" FontFamily="Georgia" FontSize="36" Margin="0,2,0,2" />
                    <TextBlock Text="Prepare a escuta e acompanhe as referências da sessão."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- Sessão -->
            <Border Style="{StaticResource Panel}" Padding="20,16" Margin="0,22,0,14">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Right" Background="{StaticResource Inset}" BorderBrush="{StaticResource Outline}"
                                BorderThickness="1" CornerRadius="14" Padding="11,5" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=StopButton}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Accent}" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PulseStart">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3"
                                                                                 Duration="0:0:0.9" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseStart" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock x:Name="Status" Text="Aguardando início" Foreground="{StaticResource Accent}"
                                           FontSize="12" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Sessão" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <WrapPanel Margin="0,14,0,0">
                        <TextBlock Text="Sistema" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                        <ComboBox x:Name="SystemPicker" AutomationProperties.Name="Sistema de RPG" Width="160"
                                  VerticalAlignment="Center" SelectionChanged="SystemChanged">
                            <ComboBoxItem Content="Vaesen" Tag="vaesen" />
                            <ComboBoxItem Content="D&amp;D 5e (2024)" Tag="dnd" />
                        </ComboBox>
                        <StackPanel x:Name="ContextModelPanel" Orientation="Horizontal" Margin="16,0,0,0">
                            <TextBlock Text="Interpretador local" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                       Margin="0,0,8,0" />
                            <ComboBox x:Name="ContextModelPicker" SelectedIndex="0" Width="170" VerticalAlignment="Center"
                                      AutomationProperties.Name="Interpretador local de Vaesen"
                                      ToolTip="Modelo que interpreta a conversa e seleciona referências do catálogo.">
                                <ComboBoxItem Content="Qwen 2.5 3B" Tag="qwen" />
                                <ComboBoxItem Content="DeepSeek R1 8B" Tag="deepseek" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <UniformGrid Columns="2" Margin="0,16,0,0">
                        <Border Style="{StaticResource Tile}" Padding="13,11" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="DISCORD" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="Áudio recebido" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,9" />
                                <ProgressBar x:Name="Meter" Minimum="0" Maximum="1" BorderThickness="0"
                                             AutomationProperties.Name="Nível do áudio recebido do Discord" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Padding="13,11" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="MICROFONE" Style="{StaticResource Eyebrow}" />
                                <TextBlock x:Name="MicrophoneStatus" Text="Microfone padrão do Windows · desligado"
                                           FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,9" />
                                <ProgressBar x:Name="MicrophoneMeter" Minimum="0" Maximum="1" BorderThickness="0"
                                             AutomationProperties.Name="Nível do microfone" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="Detail" Text="A escuta começa por ação sua." Foreground="{StaticResource Muted}"
                               FontSize="12" TextWrapping="Wrap" Margin="2,9,0,0" AutomationProperties.LiveSetting="Polite" />
                    <Border x:Name="VoiceTestPanel" Visibility="Collapsed" Style="{StaticResource Tile}"
                            Padding="14,11" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="ÚLTIMO TRECHO RECONHECIDO" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Gold}" />
                            <TextBlock x:Name="VoiceTestText" TextWrapping="Wrap" FontSize="15" Margin="0,5,0,0"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="VoiceLookupStatus" Foreground="{StaticResource Muted}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Configuração -->
            <Border Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="CONFIGURAÇÃO DA ESCUTA" Style="{StaticResource Eyebrow}" />
                    <Grid Margin="0,11,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="PID do Discord" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,5" />
                            <TextBox x:Name="PidInput" AutomationProperties.Name="PID do Discord" TextChanged="ResetConsent" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <CheckBox x:Name="IncludeMicrophone" Foreground="{StaticResource Text}"
                                      Checked="MicrophoneChanged" Unchecked="MicrophoneChanged"
                                      ToolTip="Usa a entrada padrão do Windows. Silenciar no Discord não pausa esta fonte.">
                                <TextBlock Text="Incluir meu microfone" />
                            </CheckBox>
                            <CheckBox x:Name="Consent" Foreground="{StaticResource Muted}" Margin="0,9,0,0">
                                <TextBlock Text="Os participantes foram informados e concordaram com o ensaio."
                                           TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource Outline}" Opacity="0.6" Margin="0,16,0,14" />
                    <WrapPanel>
                        <Button x:Name="LiveButton" Click="StartLive" Content="Iniciar captura"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" />
                        <Button x:Name="StopButton" Click="Stop" Content="Parar" IsEnabled="False" Margin="0,0,8,4" />
                        <Button x:Name="VoiceTestButton" Click="StartVoiceTest" Content="Testar minha voz" Margin="0,0,8,4"
                                ToolTip="Escuta apenas o microfone padrão do Windows por até 2 minutos." />
                        <Button x:Name="DemoButton" Click="StartDemo" Content="Testar com voz sintética" Margin="0,0,8,4" />
                        <Button Content="Testar notificação" Click="TestNotification" Margin="0,0,0,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Cartão de referência -->
            <Border x:Name="CardPanel" Style="{StaticResource Panel}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Gold}" CornerRadius="14,0,0,14" />
                    <StackPanel Grid.Column="1" Margin="19,15,20,15">
                        <TextBlock x:Name="CardState" Text="EXEMPLO DE CARTÃO  ·  D&amp;D 5e (2024)"
                                   Style="{StaticResource Eyebrow}" Foreground="{StaticResource Gold}" />
                        <TextBlock x:Name="CardTitle" FontFamily="Georgia" FontSize="26" TextWrapping="Wrap" Margin="0,6,0,5" />
                        <TextBlock x:Name="CardBody" TextWrapping="Wrap" LineHeight="21" Foreground="#E3E7DB" />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Dispensar" Click="DismissCard" Margin="12,0,0,0" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13">
                                <Hyperlink x:Name="CardSource" RequestNavigate="OpenSource">
                                    <Run x:Name="SourceLabel" />
                                </Hyperlink>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Processamento local · sem gravação de áudio ou transcrições"
                           Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
