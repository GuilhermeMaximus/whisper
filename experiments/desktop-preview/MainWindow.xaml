<Window x:Class="Whisper.Preview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whisper · Prévia local" Width="850" Height="755" MinWidth="625" MinHeight="475"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,24,30,23">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Biblioteca de Vaesen" Click="OpenLibrary"
                        VerticalAlignment="Top" Margin="10,10,0,0" />
                <StackPanel>
                    <TextBlock Text="WHISPER / ESCUTA LOCAL" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Copiloto de mesa" FontFamily="Georgia" FontSize="36" Margin="0,4,0,2" />
                    <TextBlock Text="Prepare a escuta e acompanhe as referências da sessão."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Panel}" Padding="17,14" Margin="0,19,0,13">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Right" Background="{StaticResource Control}" CornerRadius="12"
                                Padding="10,5" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=StopButton}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock x:Name="Status" Text="Aguardando início" Foreground="{StaticResource Accent}"
                                           FontSize="12" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Sessão" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <WrapPanel Margin="0,12,0,0">
                        <TextBlock Text="Sistema" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                        <ComboBox x:Name="SystemPicker" AutomationProperties.Name="Sistema de RPG" Width="153"
                                  VerticalAlignment="Center" SelectionChanged="SystemChanged">
                            <ComboBoxItem Content="Vaesen" Tag="vaesen" />
                            <ComboBoxItem Content="D&amp;D 5e (2024)" Tag="dnd" />
                        </ComboBox>
                        <StackPanel x:Name="ContextModelPanel" Orientation="Horizontal" Margin="12,0,0,0">
                            <TextBlock Text="Interpretador local" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                       Margin="0,0,8,0" />
                            <ComboBox x:Name="ContextModelPicker" SelectedIndex="0" Width="164" VerticalAlignment="Center"
                                      AutomationProperties.Name="Interpretador local de Vaesen"
                                      ToolTip="Modelo que interpreta a conversa e seleciona referências do catálogo.">
                                <ComboBoxItem Content="Qwen 2.5 3B" Tag="qwen" />
                                <ComboBoxItem Content="DeepSeek R1 8B" Tag="deepseek" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Border Background="{StaticResource Canvas}" CornerRadius="8" Padding="10,8" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="DISCORD" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="Áudio recebido" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,6" />
                                <ProgressBar x:Name="Meter" Minimum="0" Maximum="1" Height="5"
                                             Foreground="{StaticResource Accent}" Background="{StaticResource ControlHover}" BorderThickness="0"
                                             AutomationProperties.Name="Nível do áudio recebido do Discord" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Canvas}" CornerRadius="8" Padding="10,8" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="MICROFONE" Style="{StaticResource Eyebrow}" />
                                <TextBlock x:Name="MicrophoneStatus" Text="Microfone padrão do Windows · desligado"
                                           FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,6" />
                                <ProgressBar x:Name="MicrophoneMeter" Minimum="0" Maximum="1" Height="5"
                                             Foreground="{StaticResource Accent}" Background="{StaticResource ControlHover}" BorderThickness="0"
                                             AutomationProperties.Name="Nível do microfone" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="Detail" Text="A escuta começa por ação sua." Foreground="{StaticResource Muted}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite" />
                    <Border x:Name="VoiceTestPanel" Visibility="Collapsed" Background="{StaticResource Canvas}"
                            CornerRadius="8" Padding="10,8" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock Text="ÚLTIMO TRECHO RECONHECIDO" Style="{StaticResource Eyebrow}" />
                            <TextBlock x:Name="VoiceTestText" TextWrapping="Wrap" Margin="0,4,0,0"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="VoiceLookupStatus" Foreground="{StaticResource Muted}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Padding="17,13" Margin="0,0,0,13">
                <StackPanel>
                    <TextBlock Text="CONFIGURAÇÃO DA ESCUTA" Style="{StaticResource Eyebrow}" />
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="PID do Discord" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="PidInput" AutomationProperties.Name="PID do Discord" TextChanged="ResetConsent" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <CheckBox x:Name="IncludeMicrophone" Foreground="{StaticResource Text}"
                                      Checked="MicrophoneChanged" Unchecked="MicrophoneChanged"
                                      ToolTip="Usa a entrada padrão do Windows. Silenciar no Discord não pausa esta fonte.">
                                <TextBlock Text="Incluir meu microfone" />
                            </CheckBox>
                            <CheckBox x:Name="Consent" Foreground="{StaticResource Muted}" Margin="0,7,0,0">
                                <TextBlock Text="Os participantes foram informados e concordaram com o ensaio."
                                           TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="LiveButton" Click="StartLive" Content="Iniciar captura"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,7,3" />
                        <Button x:Name="StopButton" Click="Stop" Content="Parar" IsEnabled="False" Margin="0,0,7,3" />
                        <Button x:Name="VoiceTestButton" Click="StartVoiceTest" Content="Testar minha voz" Margin="0,0,7,3"
                                ToolTip="Escuta apenas o microfone padrão do Windows por até 2 minutos." />
                        <Button x:Name="DemoButton" Click="StartDemo" Content="Testar com voz sintética" Margin="0,0,0,3" />
                        <Button Content="Testar notificação" Click="TestNotification" Margin="7,0,0,3" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="CardPanel" Style="{StaticResource Panel}" Padding="17,13">
                <StackPanel>
                    <TextBlock x:Name="CardState" Text="EXEMPLO DE CARTÃO  ·  D&amp;D 5e (2024)"
                               Style="{StaticResource Eyebrow}" Foreground="{StaticResource Gold}" />
                    <TextBlock x:Name="CardTitle" FontFamily="Georgia" FontSize="25" TextWrapping="Wrap" Margin="0,5,0,4" />
                    <TextBlock x:Name="CardBody" TextWrapping="Wrap" />
                    <DockPanel Margin="0,7,0,0">
                        <Button DockPanel.Dock="Right" Content="Dispensar" Click="DismissCard" Margin="10,0,0,0" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                            <Hyperlink x:Name="CardSource" RequestNavigate="OpenSource" Foreground="{StaticResource Accent}">
                                <Run x:Name="SourceLabel" />
                            </Hyperlink>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="Processamento local · sem gravação de áudio ou transcrições"
                       Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
